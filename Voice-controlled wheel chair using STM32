/* Enable DWT cycle counter for micros() */ 
static void ensure_dwt_enabled(void) 
{ 
if (!(CoreDebug->DEMCR & CoreDebug_DEMCR_TRCENA_Msk)) CoreDebug->DEMCR |= 
CoreDebug_DEMCR_TRCENA_Msk; 
if (!(DWT->CTRL & DWT_CTRL_CYCCNTENA_Msk)) DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk; 
} 
/* micros() using DWT->CYCCNT */ 
static uint32_t micros(void) 
{ 
} 
uint32_t cycles = DWT->CYCCNT; 
uint32_t mhz = HAL_RCC_GetHCLKFreq() / 1000000U; 
if (mhz == 0) return 0; 
return cycles / mhz; 
/* Ultrasonic trigger pulse */ 
static void ultrasonic_trigger(void) 
{ 
HAL_GPIO_WritePin(US_TRIG_GPIO, US_TRIG_PIN, GPIO_PIN_RESET); 
HAL_Delay(2); 
 
HAL_GPIO_WritePin(US_TRIG_GPIO, US_TRIG_PIN, GPIO_PIN_SET); 
uint32_t t = micros(); 
while (micros() - t < 10) {} // 10 us pulse 
HAL_GPIO_WritePin(US_TRIG_GPIO, US_TRIG_PIN, GPIO_PIN_RESET); 
} 
/* Read ultrasonic distance in cm (polling) */ 
static uint32_t ultrasonic_read_cm(void) 
{ 
} 
ultrasonic_trigger(); 
uint32_t t0 = micros(); 
while (HAL_GPIO_ReadPin(US_ECHO_GPIO, US_ECHO_PIN) == GPIO_PIN_RESET) { 
if (micros() - t0 > 30000U) return 999; // timeout 
} 
uint32_t t_rise = micros(); 
while (HAL_GPIO_ReadPin(US_ECHO_GPIO, US_ECHO_PIN) == GPIO_PIN_SET) { 
if (micros() - t_rise > 30000U) break; // timeout 
} 
uint32_t t_fall = micros(); 
uint32_t pulse = t_fall - t_rise; // microseconds 
// distance (cm) = (pulse_us * 0.0343) / 2 
float dist = (pulse * 0.0343f) / 2.0f; 
return (uint32_t)(dist + 0.5f); 
