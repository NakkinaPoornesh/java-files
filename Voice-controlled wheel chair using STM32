/* Main program */ 
int main(void) 
{ 
/* MCU Init */ 
HAL_Init(); 
SystemClock_Config(); 
/* Peripheral init - these functions are from CubeMX generated code */ 
MX_GPIO_Init(); 
MX_USART1_UART_Init(); 
MX_TIM2_Init(); 
/* Enable DWT for micros() */ 
ensure_dwt_enabled(); 
/* Start PWM channels (compare value 0 initially) */ 
HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1); 
HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_2); 
/* Safety: start stopped */ 
motors_stop(); 
/* Start UART receive interrupt for single-byte commands */ 
HAL_UART_Receive_IT(&huart1, (uint8_t *)&rx_byte, 1); 
 
    const uint32_t ULTRA_PERIOD_MS = 150;   // measurement period 
    const uint32_t OBSTACLE_THRESHOLD_CM = 30; 
    uint32_t last_ultra_ts = HAL_GetTick(); 
 
    while (1) 
    { 
        /* Emergency Stop (active LOW on PC13). If pressed, kill motors and skip commands. */ 
        if (HAL_GPIO_ReadPin(EMG_GPIO, EMG_PIN) == GPIO_PIN_RESET) { 
            motors_stop(); 
            buzzer_off(); 
            HAL_Delay(50); 
            continue; 
        } 
 
        /* Command processing from HC-05 (single char commands) */ 
        if (cmd_ready) { 
            cmd_ready = 0; 
            uint8_t c = rx_byte; 
            /* restart UART interrupt for next byte */ 
            HAL_UART_Receive_IT(&huart1, (uint8_t *)&rx_byte, 1); 
 
            switch (c) { 
                case 'F': motors_forward(); break; 
                case 'B': motors_backward(); break; 
                case 'L': motors_turn_left(); break; 
                case 'R': motors_turn_right(); break; 
                case 'S': 
                default: motors_stop(); break; 
            } 
        } 

 
        /* Periodic ultrasonic check */ 
        if ((HAL_GetTick() - last_ultra_ts) >= ULTRA_PERIOD_MS) { 
            last_ultra_ts = HAL_GetTick(); 
            uint32_t dist = ultrasonic_read_cm(); 
            if (dist <= OBSTACLE_THRESHOLD_CM) { 
                /* Obstacle detected: beep and avoidance maneuver */ 
                buzzer_on(); 
                HAL_Delay(120); 
                buzzer_off(); 
 
                if (avoid_left_next) motors_turn_left(); 
                else motors_turn_right(); 
                avoid_left_next = !avoid_left_next; 
 
                HAL_Delay(400); // turning duration - tune on your platform 
                motors_stop(); 
            } 
        } 
 
        HAL_Delay(5); // small idle 
    } 
} 
 
